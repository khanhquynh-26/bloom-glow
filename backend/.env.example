# Copy file này thành .env rồi chỉnh lại cho máy của bạn
PORT=3001
FRONTEND_URL=http://localhost:5173

# MySQL (XAMPP mặc định: root, không mật khẩu)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=bloom_glow

# JWT (đổi secret trước khi deploy; thời hạn tính bằng giây, 604800 = 7 ngày)
JWT_SECRET=bloom_glow_dev_secret_key_2026
JWT_EXPIRES_IN_SECONDS=604800
